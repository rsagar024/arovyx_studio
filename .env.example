# --- NVIDIA NIM (server-only; never exposed to the browser) ---
NVIDIA_NIM_API_KEY=""
# Optional backup key, used when the first one hits its limit or is refused.
NVIDIA_NIM_API_KEY_2=""
NVIDIA_NIM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"

# --- Hidden admin panel (/studio) ---
ADMIN_SECRET_KEY="change-this-to-a-strong-password"
ADMIN_JWT_SECRET="change-this-random-string"

# --- Public base URL (canonical / Open Graph / sitemap) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- PostgreSQL (Neon) ---
# Pooled connection used by the app at runtime (Neon host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection used by `prisma db push`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Studio → Quiz Master (optional; server-only) ---
# Firebase Admin SDK key JSON for project quizmaster-3be48, on ONE line
# (Firestore, FCM, Auth and Remote Config). Without it the tab only does dry runs.
QUIZMASTER_FIREBASE_SERVICE_ACCOUNT=""
QUIZMASTER_FIREBASE_PROJECT_ID="quizmaster-3be48"
# NIM model ids; empty uses the defaults (generate and translate:
# nvidia/nemotron-3.5-super-vl-120b-a12b, verify: mistralai/mistral-large-4-1t-a52b).
# The verifier must be a different model family from the generator.
# Reuses NVIDIA_NIM_API_KEY / NVIDIA_NIM_BASE_URL.
QUIZMASTER_GEN_MODEL=""
QUIZMASTER_VERIFY_MODEL=""
QUIZMASTER_TRANSLATE_MODEL=""

# --- Studio → Color Tap (optional; server-only) ---
# Firebase Admin SDK key JSON for project color-tap-c06bf, on ONE line, with the
# Firebase Authentication Admin role. A key for any other project is refused.
# Without it the tab can't run.
COLORTAP_FIREBASE_SERVICE_ACCOUNT=""
