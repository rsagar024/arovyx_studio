{
  "name": "arovyx-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Arovyx Studio — AI-powered developer portfolio website",
  "scripts": {
    "predev": "tsx prisma/seed.ts --if-empty",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "firebase-admin": "14.5.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.454.0",
    "motion": "^14.7.1",
    "next": "^14.2.18",
    "pako": "2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "server-only": "0.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/pako": "2.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "3.2.7"
  }
}
