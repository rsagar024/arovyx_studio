// Arovyx Studio — Prisma schema (PostgreSQL on Neon)
// Column design dates from the original SQLite version and is kept portable:
// - category/status are stored as String columns, validated by Zod enums in lib/validators.ts
// - tags/techStack/features are stored as JSON-encoded String columns
//   and exposed as string[] via the mappers in lib/validators.ts

generator client {
  provider = "prisma-client-js"
  // "native" for local/CI, rhel-openssl-3.0.x for Vercel's serverless runtime
  // (the client is generated on the GitHub Actions runner, then deployed).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL") // direct connection (prisma db push)
}

model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String
  longDescription  String   @default("")
  category         String   @default("APP") // APP | GAME | PACKAGE | PLUGIN
  tags             String   @default("[]") // JSON string[]
  techStack        String   @default("[]") // JSON string[]
  features         String   @default("[]") // JSON string[]
  status           String   @default("IN_DEVELOPMENT") // LIVE | IN_DEVELOPMENT | ARCHIVED
  version          String?
  sourceUrl        String
  demoUrl          String?
  imageUrl         String? // app icon / thumbnail
  bannerUrl        String? // feature graphic / header background
  screenshots      String   @default("[]") // JSON string[] (phone screenshots)
  stars            Int?
  downloads        Int?
  isPublished      Boolean  @default(true)
  aiGenerated      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, isPublished])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// Single-row site settings (owner profile + social links)
model SiteConfig {
  id            Int    @id @default(1)
  siteName      String @default("Arovyx Studio")
  ownerName     String @default("Arovyx Studio Owner")
  tagline       String @default("Building apps, games, packages & plugins.")
  bio           String @default("")
  email         String @default("")
  githubUrl     String @default("")
  linkedinUrl   String @default("")
  instagramUrl  String @default("")
  avatarUrl     String @default("")
  resumeUrl     String @default("")
  heroProjectIds String @default("[]") // JSON string[] — up to 3 project ids for the home hero cards
  updatedAt     DateTime @updatedAt
}

// AI usage log, shown in admin Overview
model AiLog {
  id        String   @id @default(cuid())
  url       String
  action    String   @default("generate") // generate | improve
  success   Boolean
  error     String?
  model     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
