// Arovyx Studio — Prisma schema (PostgreSQL on Neon)
// Column design dates from the original SQLite version and is kept portable:
// - category/status are stored as String columns, validated by Zod enums in lib/validators.ts
// - tags/techStack/features are stored as JSON-encoded String columns
//   and exposed as string[] via the mappers in lib/validators.ts

generator client {
  provider = "prisma-client-js"
  // "native" for local/CI, rhel-openssl-3.0.x for Vercel's serverless runtime
  // (the client is generated on the GitHub Actions runner, then deployed).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL") // direct connection (prisma db push)
}

model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String
  longDescription  String   @default("")
  category         String   @default("APP") // APP | GAME | PACKAGE | PLUGIN
  tags             String   @default("[]") // JSON string[]
  techStack        String   @default("[]") // JSON string[]
  features         String   @default("[]") // JSON string[]
  status           String   @default("IN_DEVELOPMENT") // LIVE | IN_DEVELOPMENT | ARCHIVED
  version          String?
  sourceUrl        String
  demoUrl          String?
  imageUrl         String? // app icon / thumbnail
  bannerUrl        String? // feature graphic / header background
  publisher        String? // "published by" — developer / owner / author
  privacyPolicyUrl String? // link to the project's privacy policy
  termsAndConditionsUrl String? // link to the project's terms & conditions
  screenshots      String   @default("[]") // JSON string[] (phone screenshots)
  stars            Int?
  downloads        Int?
  isPublished      Boolean  @default(true)
  aiGenerated      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, isPublished])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// Single-row site settings (owner profile + social links)
model SiteConfig {
  id            Int    @id @default(1)
  siteName      String @default("Arovyx Studio")
  ownerName     String @default("Arovyx Studio Owner")
  tagline       String @default("Building apps, games, packages & plugins.")
  bio           String @default("")
  email         String @default("")
  githubUrl     String @default("")
  linkedinUrl   String @default("")
  instagramUrl  String @default("")
  avatarUrl     String @default("")
  resumeUrl     String @default("")
  heroProjectIds String @default("[]") // JSON string[] — up to 3 project ids for the home hero cards
  featuredProjectIds String @default("[]") // JSON string[] — up to 6 project ids for "Featured projects"
  updatedAt     DateTime @updatedAt
}

// AI usage log, shown in admin Overview
model AiLog {
  id        String   @id @default(cuid())
  url       String
  action    String   @default("generate") // generate | improve
  success   Boolean
  error     String?
  model     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// --- Quiz Master automation (Studio → Quiz Master) ---------------------------
// The jobs that used to run on GitHub Actions in the quizmaster repo, run from
// the Studio tab in short resumable ticks. See src/lib/quizmaster/engine.ts.

// Single-row schedule: the countdown every tab and device shows.
model QuizSchedule {
  id            Int       @id @default(1)
  intervalHours Float     @default(12) // 11-12, clamped by the API
  nextRunAt     DateTime?
  paused        Boolean   @default(false)
  lastCleanupAt DateTime? // last successful (non-dry-run) guest cleanup
  updatedAt     DateTime  @updatedAt
}

model QuizRun {
  id          String    @id @default(cuid())
  kind        String // question_bank | guest_cleanup | seed
  trigger     String    @default("manual") // timer | manual
  slot        String    @default("") // am | pm | x{n}; "" for guest_cleanup
  options     String    @default("{}") // JSON: date, force, dryRun, categories, days, ...
  status      String    @default("running") // queued | running | succeeded | partial | failed | cancelled
  lockedUntil DateTime? // run lease: renewed on every tick, expires 10 min after the last one
  tickUntil   DateTime? // per-tick lease: one tick in flight per run
  tickToken   String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  summary     String    @default("{}") // JSON: per-category / per-step results
  createdAt   DateTime  @default(now())
  steps       QuizRunStep[]
  logs        QuizLog[]

  @@index([kind, status])
  @@index([createdAt])
}

model QuizRunStep {
  id        String   @id @default(cuid())
  runId     String
  run       QuizRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  key       String // e.g. science:verify:0:2, publish, daily_quiz
  order     Int
  status    String   @default("pending") // pending | done | failed | skipped
  attempts  Int      @default(0)
  state     String   @default("{}") // JSON: the unit's carried state (intermediate questions)
  error     String?
  updatedAt DateTime @updatedAt

  @@unique([runId, key])
  @@index([runId, order])
}

model QuizLog {
  id      String   @id @default(cuid())
  runId   String
  run     QuizRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  at      DateTime @default(now())
  level   String   @default("info") // info | warn | error
  message String

  @@index([runId, at])
}

// --- Color Tap guest cleanup (Studio → Color Tap) ----------------------------
// The job that used to run on GitHub Actions in the color_tap repo, run from
// the Studio tab in short resumable ticks. See src/lib/colortap/engine.ts.

// Single-row settings.
model ColorTapSchedule {
  id            Int       @id @default(1)
  autoEnabled   Boolean   @default(false) // off until a dry run has been checked
  days          Int       @default(90) // inactivity window of automatic runs (at least 30)
  lastCleanupAt DateTime? // last successful (non-dry-run) cleanup
  lastAutoAt    DateTime? // last automatic start, so a failing run retries hourly, not per minute
  updatedAt     DateTime  @updatedAt
}

model ColorTapRun {
  id          String    @id @default(cuid())
  trigger     String    @default("manual") // timer | manual
  days        Int
  dryRun      Boolean   @default(true)
  status      String    @default("running") // running | succeeded | failed | cancelled
  state       String    @default("{}") // JSON: page token, pages and counts so far
  attempts    Int       @default(0) // failures of the current page
  error       String?
  lockedUntil DateTime? // run lease: renewed on every tick, expires 10 min after the last one
  tickUntil   DateTime? // per-tick lease: one tick in flight per run
  tickToken   String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  logs        ColorTapLog[]

  @@index([status])
  @@index([createdAt])
}

model ColorTapLog {
  id      String      @id @default(cuid())
  runId   String
  run     ColorTapRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  at      DateTime    @default(now())
  level   String      @default("info") // info | warn | error
  message String

  @@index([runId, at])
}
